{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "dtype",
    "shape",
    "byte_order",
    "layout",
    "payload_bytes",
    "sha256"
  ],
  "properties": {
    "version": {
      "const": 1,
      "type": "integer"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "dtype": {
      "enum": [
        "float32",
        "float16",
        "bfloat16",
        "int32",
        "int64",
        "uint8"
      ]
    },
    "shape": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      }
    },
    "byte_order": {
      "const": "little"
    },
    "layout": {
      "const": "contiguous"
    },
    "payload_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 268435456
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
