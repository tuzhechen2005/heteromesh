{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "platform",
    "runtime",
    "backend",
    "supported_ops",
    "wire_dtypes",
    "compute_dtypes",
    "memory"
  ],
  "properties": {
    "protocol_version": {
      "type": "integer",
      "const": 1
    },
    "platform": {
      "enum": [
        "windows",
        "macos",
        "ios",
        "linux"
      ]
    },
    "runtime": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "type": "string",
      "minLength": 1
    },
    "supported_ops": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "wire_dtypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "compute_dtypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "memory": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unified",
        "host_budget_bytes",
        "accelerator_budget_bytes"
      ],
      "properties": {
        "unified": {
          "type": "boolean"
        },
        "host_budget_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "accelerator_budget_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
