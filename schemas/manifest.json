{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "model_id",
    "revision",
    "source",
    "license",
    "profile",
    "fragments"
  ],
  "properties": {
    "protocol_version": {
      "type": "integer",
      "const": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "fragments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "backend",
          "compute_dtype",
          "required_ops",
          "inputs",
          "outputs",
          "weights",
          "memory"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,128}$"
          },
          "backend": {
            "type": "string",
            "minLength": 1
          },
          "compute_dtype": {
            "enum": [
              "float32",
              "float16",
              "bfloat16",
              "int32",
              "int64",
              "uint8"
            ]
          },
          "required_ops": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "dtype",
                "shape"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,128}$"
                },
                "dtype": {
                  "enum": [
                    "float32",
                    "float16",
                    "bfloat16",
                    "int32",
                    "int64",
                    "uint8"
                  ]
                },
                "shape": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  }
                }
              }
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "dtype",
                "shape"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,128}$"
                },
                "dtype": {
                  "enum": [
                    "float32",
                    "float16",
                    "bfloat16",
                    "int32",
                    "int64",
                    "uint8"
                  ]
                },
                "shape": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  }
                }
              }
            }
          },
          "weights": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sha256",
                "bytes"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                }
              }
            }
          },
          "memory": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host",
              "accelerator"
            ],
            "properties": {
              "host": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "resident_weights_bytes",
                  "peak_activations_bytes",
                  "workspace_bytes",
                  "transfer_buffers_bytes",
                  "runtime_overhead_bytes",
                  "safety_margin_bytes",
                  "loading_peak_bytes"
                ],
                "properties": {
                  "resident_weights_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  },
                  "peak_activations_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  },
                  "workspace_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  },
                  "transfer_buffers_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  },
                  "runtime_overhead_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  },
                  "safety_margin_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  },
                  "loading_peak_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  }
                }
              },
              "accelerator": {
                "anyOf": [
                  {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "resident_weights_bytes",
                      "peak_activations_bytes",
                      "workspace_bytes",
                      "transfer_buffers_bytes",
                      "runtime_overhead_bytes",
                      "safety_margin_bytes",
                      "loading_peak_bytes"
                    ],
                    "properties": {
                      "resident_weights_bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9223372036854775807
                      },
                      "peak_activations_bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9223372036854775807
                      },
                      "workspace_bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9223372036854775807
                      },
                      "transfer_buffers_bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9223372036854775807
                      },
                      "runtime_overhead_bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9223372036854775807
                      },
                      "safety_margin_bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9223372036854775807
                      },
                      "loading_peak_bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9223372036854775807
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
